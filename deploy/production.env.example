# Plantilla. En el servidor, `bash deploy/crear-env.sh` crea deploy/production.env
# con claves aleatorias. Ese archivo NO se sube a Git ni se pega en ningún chat.

# Sin dominio propio: la IP elástica con guiones + .sslip.io, por ejemplo 3-120-45-67.sslip.io
MIUNI_DOMAIN=

MIUNI_POSTGRES_DB=miuni
MIUNI_POSTGRES_USER=miuni
MIUNI_POSTGRES_PASSWORD=
JWT_KEY=

# Clave de Google AI Studio para el chat (la misma que usa MiUni-RAG en tu PC).
GEMINI_API_KEY=
MIUNI_RAG_PATH=../MiUni-RAG

# Correo de verificación de cuentas (por ejemplo Gmail con contraseña de aplicación).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=
