# Instalacion nueva: powershell -File .\scripts\dev.ps1 -Action init
# Ese comando crea .env y genera las dos claves vacias de abajo.
MIUNI_POSTGRES_HOST=127.0.0.1
MIUNI_POSTGRES_DB=miuni_dev
MIUNI_POSTGRES_USER=miuni
MIUNI_POSTGRES_PASSWORD=
MIUNI_POSTGRES_PORT=5433
JWT_KEY=
# RAG local o URL del servicio compartido por el equipo. Conservar /api/v1/.
RAG_BASE_URL=http://127.0.0.1:8000/api/v1/
